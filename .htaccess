DirectoryIndex index.html

RewriteEngine On

# 1. Specific legacy redirects (forces HTTPS and www in the destination)
RewriteRule ^blog/?$ https://www.7brewguide.com/7brew-blog [R=301,L,NC]
RewriteRule ^how-rewards-work/?$ https://www.7brewguide.com/7brew-rewards [R=301,L,NC]
RewriteRule ^prices/?$ https://www.7brewguide.com/7brew-menu [R=301,L,NC]
RewriteRule ^index\.html$ https://www.7brewguide.com/ [R=301,L,NC]

# 2. General Force HTTPS and www
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^7brewguide\.com$ [NC]
RewriteRule ^ https://www.7brewguide.com%{REQUEST_URI} [R=301,L]

# 3. Strip trailing slashes from non-directory requests (relative redirect to avoid SSL termination loops)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/$
RewriteCond %{REQUEST_URI} (.+)/$
RewriteRule ^ %1 [R=301,L]

# 4. Redirect direct HTML file requests to clean 7brew- URLs (fully canonicalized)
RewriteCond %{THE_REQUEST} \s/calorie-calculator\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-calorie-calculator [R=301,L]

RewriteCond %{THE_REQUEST} \s/menu\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-menu [R=301,L]

RewriteCond %{THE_REQUEST} \s/locations\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-locations [R=301,L]

RewriteCond %{THE_REQUEST} \s/blog\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-blog [R=301,L]

RewriteCond %{THE_REQUEST} \s/rewards\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-rewards [R=301,L]

RewriteCond %{THE_REQUEST} \s/deals\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-deals [R=301,L]

RewriteCond %{THE_REQUEST} \s/franchise\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-franchise [R=301,L]

RewriteCond %{THE_REQUEST} \s/merch-shop\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-merch-shop [R=301,L]

RewriteCond %{THE_REQUEST} \s/gift-cards\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-gift-cards [R=301,L]

RewriteCond %{THE_REQUEST} \s/secret-menu\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-secret-menu [R=301,L]

RewriteCond %{THE_REQUEST} \s/recipe-maker\.html\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-recipe-maker [R=301,L]

# Permanent redirect for Careers to the official corporate page
RewriteRule ^7brew-careers$ https://7brew.com/careers [R=301,L]
RewriteRule ^careers$ https://7brew.com/careers [R=301,L]

# Internal rewrites for clean section permalinks
RewriteRule ^7brew-rewards$ rewards.html [L]
RewriteRule ^rewards$ rewards.html [L]

# Route clean 7brew- prefixed paths to actual html files
RewriteRule ^7brew-menu$ menu.html [L]
RewriteRule ^7brew-locations$ locations.html [L]
RewriteRule ^7brew-blog$ blog.html [L]
RewriteRule ^7brew-calorie-calculator$ calorie-calculator.html [L]
RewriteRule ^7brew-nutrition$ nutrition.html [L]
RewriteRule ^7brew-sugar-free$ sugar-free.html [L]
RewriteRule ^7brew-kids-menu$ kids-menu.html [L]

# Route clean 7brew-locations/[state] to locations/[state].html
RewriteRule ^7brew-locations/(arkansas|missouri|oklahoma|kansas)/?$ locations/$1.html [L]

# 301 Redirect old /locations/[state] to /7brew-locations/[state]
RewriteCond %{THE_REQUEST} \s/locations/(arkansas|missouri|oklahoma|kansas)\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-locations/%1 [R=301,L]

# Route clean category slugs to menu.html
RewriteRule ^7orignal$ menu.html [L]
RewriteRule ^7classics$ menu.html [L]
RewriteRule ^featured-drinks$ menu.html [L]
RewriteRule ^7energy$ menu.html [L]
RewriteRule ^7fizz$ menu.html [L]
RewriteRule ^teas-chai-matcha$ menu.html [L]

RewriteRule ^7brew-recipe-maker$ recipe-maker.html [L]
RewriteRule ^recipe-maker$ recipe-maker.html [L]

RewriteRule ^7brew-secret-menu$ secret-menu.html [L]
RewriteRule ^secret-menu$ secret-menu.html [L]

RewriteRule ^7brew-deals$ deals.html [L]
RewriteRule ^deals$ deals.html [L]

RewriteRule ^7brew-franchise$ franchise.html [L]
RewriteRule ^franchise$ franchise.html [L]

RewriteRule ^7brew-merch-shop$ merch-shop.html [L]
RewriteRule ^merch-shop$ merch-shop.html [L]

RewriteRule ^7brew-gift-cards$ gift-cards.html [L]
RewriteRule ^gift-cards$ gift-cards.html [L]

RewriteRule ^7brew-hours$ locations.html [L]
RewriteRule ^hours$ locations.html [L]

RewriteRule ^7brew-delivery$ locations.html [L]
RewriteRule ^delivery$ locations.html [L]

# Clean URLs: map /filename to filename.html
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^([^/]+)/?$ $1.html [L]

# Route clean 7brew-menu/[category] to menu/[category].html
RewriteRule ^7brew-menu/(coffee|energy-drinks|smoothies|teas-and-chai|lemonades|shakes|fizz)/?$ menu/$1.html [L]

# 301 Redirect old /menu/[category] to /7brew-menu/[category]
RewriteCond %{THE_REQUEST} \s/menu/(coffee|energy-drinks|smoothies|teas-and-chai|lemonades|shakes|fizz)\s [NC]
RewriteRule ^ https://www.7brewguide.com/7brew-menu/%1 [R=301,L]

RewriteRule ^menu/([^/]+)/?$ menu/$1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^locations/([^/]+)/?$ locations/$1.html [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^rewards/([^/]+)/?$ rewards/$1.html [L]
